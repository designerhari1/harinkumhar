---
const links = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#services', label: 'Services' },
  { href: '#contact', label: 'Contact' }
];
---

<header class="fixed top-0 z-50 w-full bg-[#f9f9f9]/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-[1440px] items-center justify-between px-8 py-6">
    <a class="font-headline text-base font-bold text-[#2d3435] md:text-xl" href="#home">H</a>
    <div class="hidden items-center gap-10 md:flex">
      {
        links.map((link) => (
          <a class="font-headline text-lg italic tracking-tight text-[#5f5e5e]/70 transition-colors duration-300 hover:text-[#2d3435]" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </div>
    <a
      class="inline-flex rounded-full bg-[#5f5e5e] px-6 py-2 font-label text-sm uppercase tracking-widest text-[#faf7f6] transition-all duration-300 hover:bg-[#535252] active:scale-95"
      href="mailto:hello@harinkumhar.com"
    >
      Let&apos;s Talk
    </a>
  </nav>
</header>

<nav class="fixed bottom-4 left-1/2 z-50 flex w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 items-center justify-between rounded-full border border-[#adb3b4]/20 bg-[#f9f9f9]/95 px-3 py-2 shadow-[0_8px_20px_rgba(0,0,0,0.08)] backdrop-blur-md md:hidden" id="mobile-bottom-nav">
  <a class="mobile-bottom-link rounded-full bg-[#2d3435] px-3 py-2 font-label text-[10px] uppercase tracking-[0.16em] text-[#faf7f6] transition-colors duration-200" href="#home">Home</a>
  <a class="mobile-bottom-link rounded-full px-3 py-2 font-label text-[10px] uppercase tracking-[0.16em] text-[#5f5e5e] transition-colors duration-200 hover:bg-[#efefef]" href="#work">Work</a>
  <a class="mobile-bottom-link rounded-full px-3 py-2 font-label text-[10px] uppercase tracking-[0.16em] text-[#5f5e5e] transition-colors duration-200 hover:bg-[#efefef]" href="#about">About</a>
  <a class="mobile-bottom-link rounded-full px-3 py-2 font-label text-[10px] uppercase tracking-[0.16em] text-[#5f5e5e] transition-colors duration-200 hover:bg-[#efefef]" href="#contact">Contact</a>
</nav>

<script is:inline>
  const mobileNav = document.getElementById('mobile-bottom-nav');

  if (mobileNav) {
    const baseClass =
      'mobile-bottom-link rounded-full px-3 py-2 font-label text-[10px] uppercase tracking-[0.16em] transition-colors duration-200';
    const activeClass = 'bg-[#2d3435] text-[#faf7f6]';
    const inactiveClass = 'text-[#5f5e5e] hover:bg-[#efefef]';

    const links = Array.from(mobileNav.querySelectorAll('a[href^="#"]'));
    const sections = links
      .map((link) => {
        const id = link.getAttribute('href')?.replace('#', '');
        if (!id) return null;
        return { id, link, section: document.getElementById(id) };
      })
      .filter((entry) => entry && entry.section);

    const setActive = (activeId) => {
      links.forEach((link) => {
        const id = link.getAttribute('href')?.replace('#', '');
        link.className = `${baseClass} ${id === activeId ? activeClass : inactiveClass}`;
      });
    };

    const updateByScroll = () => {
      if (window.innerWidth >= 768 || sections.length === 0) return;

      const marker = window.scrollY + window.innerHeight * 0.35;
      let current = sections[0];

      sections.forEach((item) => {
        if (item.section.offsetTop <= marker) current = item;
      });

      setActive(current.id);
    };

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('href')?.replace('#', '');
        if (id) setActive(id);
      });
    });

    window.addEventListener('scroll', updateByScroll, { passive: true });
    window.addEventListener('resize', updateByScroll);
    window.addEventListener('hashchange', updateByScroll);
    updateByScroll();
  }
</script>
