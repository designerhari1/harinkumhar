---
interface Props {
  id?: string;
}

const { id = 'contact' } = Astro.props;
---

<section class="mx-auto max-w-[1440px] px-8 py-40 text-center" id={id}>
  <span class="mb-6 block font-label text-[10px] uppercase tracking-[0.2em] text-secondary">Let&apos;s Collaborate</span>
  <h2 class="mb-12 font-headline text-5xl -tracking-[0.03em] md:text-8xl">
    Ready to build something <span class="italic font-light">exceptional?</span>
  </h2>
  <div class="flex flex-col justify-center gap-6 md:flex-row">
    <a
      class="rounded-full bg-primary px-10 py-5 font-label text-xs uppercase tracking-[0.3em] text-on-primary transition-all duration-300 hover:-translate-y-1 hover:bg-primary-dim"
      href="mailto:hello@harinarayan.com"
    >
      Start a Project
    </a>
    <a
      class="rounded-full border border-outline-variant/30 bg-transparent px-10 py-5 font-label text-xs uppercase tracking-[0.3em] text-primary transition-all duration-300 hover:border-primary"
      href="/work"
    >
      View Portfolio
    </a>
  </div>
</section>
