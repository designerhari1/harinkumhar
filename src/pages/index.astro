---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = false;

const sent = Astro.url.searchParams.get('sent') === '1';
const user = Astro.locals.user;
---

<SiteLayout title="EC | Frontend & Webflow Developer App">
  <section class="section-shell grid min-h-[88vh] grid-cols-1 items-center gap-12 px-6 py-16 md:px-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="mb-5 font-label text-xs uppercase tracking-[0.2em] text-brandSoft">Available for freelance</p>
      <h1 class="font-headline text-5xl font-bold leading-tight tracking-tight md:text-7xl">
        Building modern, <span class="text-brandSoft">high-performing</span> websites.
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-mist">
        Webflow + frontend product studio experience wrapped into one app. Explore services, message me,
        then hop into your private dashboard to track requests.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#work" class="rounded-xl bg-brand px-7 py-4 font-headline font-bold text-white shadow-halo transition hover:scale-105">
          View Projects
        </a>
        {
          user ? (
            <a href="/dashboard" class="rounded-xl border border-line px-7 py-4 font-headline font-bold text-white transition hover:bg-coal">Open Dashboard</a>
          ) : (
            <a href="/signup" class="rounded-xl border border-line px-7 py-4 font-headline font-bold text-white transition hover:bg-coal">Create Account</a>
          )
        }
      </div>
    </div>
    <div class="relative lg:col-span-5">
      <div class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-brand/30 blur-[100px]"></div>
      <div class="glass rotate-2 rounded-3xl p-4 transition duration-700 hover:rotate-0">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBevIafPBE7PT16YSMFGlU6hrCzHPEzLGvB_Rk4UQLTi09j94qAST4RbHkvYp6XzvnqIzG67W8jPidAdx65k9fLbta2cji8n7ABWYmoDDch1aQgwnoB3uMy3bxHcJi93jotOU4FKC3JwIaHpR7i8kJpQHkiYpRGubiUadE8fCPA5q69gJ9061tHKqVx_iAhabrGAyQy-NBKBy468MJ_2ZZSYhGLk_Ld122a7_-qqAyMmQFOUs1po17UPUjgjF_11KZuGiBUytuLbw"
          alt="Frontend workspace"
          class="aspect-[4/5] w-full rounded-2xl object-cover grayscale transition duration-700 hover:grayscale-0"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section id="about" class="border-y border-line/70 bg-coal/60 py-24">
    <div class="section-shell grid grid-cols-1 gap-16 px-6 md:px-8 lg:grid-cols-2">
      <div>
        <h2 class="font-headline text-4xl font-bold tracking-tight md:text-5xl">
          Crafting interfaces with <span class="text-brandSoft">technical precision</span>.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-mist">
          I help teams bridge complex functionality and high-end aesthetics. Every project is tuned for speed,
          accessibility, and responsive integrity.
        </p>
      </div>
      <div>
        <p class="font-label text-xs uppercase tracking-[0.25em] text-mist">Expertise</p>
        <div class="mt-6 flex flex-wrap gap-3" id="work">
          {['Webflow', 'React.js', 'Next.js', 'Astro', 'Responsive Design', 'API Integration', 'Performance', 'UI Systems'].map((skill) => (
            <span class="rounded-full border border-line bg-ink/80 px-4 py-2 text-xs font-bold uppercase tracking-wider text-mist">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="section-shell px-6 py-24 md:px-8">
    <div class="mb-12">
      <h2 class="font-headline text-4xl font-bold tracking-tight md:text-5xl">Focused Services</h2>
      <p class="mt-4 max-w-2xl text-mist">Tailored digital solutions for growing businesses.</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {[
        ['Webflow Development', 'Pixel-perfect implementation with structured CMS architecture.'],
        ['Frontend Development', 'Scalable React, Next.js, and Astro builds with speed-first engineering.'],
        ['Landing Page Design', 'High-conversion landing pages with bold editorial visual language.'],
        ['Responsive Development', 'Cross-device consistency from mobile to large desktop displays.'],
        ['Website Redesign', 'Legacy site upgrades with modern UX and performance optimization.'],
        ['Product UI Polish', 'Interaction and visual refinement for product teams shipping fast.']
      ].map(([title, copy]) => (
        <article class="glass rounded-2xl p-8 transition duration-300 hover:-translate-y-1 hover:border-brandSoft/40">
          <h3 class="font-headline text-xl font-bold">{title}</h3>
          <p class="mt-4 text-sm leading-relaxed text-mist">{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-line/70 bg-coal/50 py-24">
    <div class="section-shell px-6 md:px-8">
      <h2 class="text-center font-headline text-4xl font-bold tracking-tight">Client Voice</h2>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {[
          ['Marcus Sterling', 'Founder, Apex Creative', 'The attention to detail in the Webflow build was remarkable.'],
          ['Lena Laurent', 'CTO, Flux Systems', 'Fast frontend delivery and polished design execution.'],
          ['David Rossi', 'Marketing Director, Nexus', 'Load times improved dramatically after the redesign.']
        ].map(([name, role, quote]) => (
          <article class="glass rounded-2xl p-8">
            <p class="text-sm italic leading-relaxed text-mist">"{quote}"</p>
            <div class="mt-6 border-t border-line/70 pt-4">
              <p class="font-headline text-sm font-bold">{name}</p>
              <p class="font-label text-[10px] uppercase tracking-[0.2em] text-mist">{role}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section-shell grid grid-cols-1 gap-14 px-6 py-24 md:px-8 lg:grid-cols-2">
    <div>
      <h2 class="font-headline text-5xl font-bold leading-tight tracking-tight">
        Let's Build Something Great <span class="text-brandSoft">Together</span>.
      </h2>
      <p class="mt-6 max-w-xl text-lg text-mist">
        Share your project details and I will follow up with a proposal. Signed-in users will also see this saved in
        their dashboard.
      </p>
      <img
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuDWXXt_Nmke0qcYbXOls1WaD8IcSkcxbZpakXlLIuXkvu1uIz_0m6brRCvZFaXctchiCkDMjFpww6TBHlbOOougCxzZrLdWQOGt4SQW7aVuK2Jx2o-P-4tOFFDDutPA32Z5DWivkYLeM9mwTynHvcgNmXmg9Jrn-otMrZJ_NcwTvXiqZa-fYTIeVOVJVtVo6VbLH0_pGZfqaqcYWxa4oK2KITzM2hWF3sHUS_cTCXsqh4Gq0CgHfgsryQMHOgYclXlyRR9TTf1Brw"
        alt="Abstract technical system"
        class="mt-10 h-52 w-full rounded-2xl object-cover opacity-80"
        loading="lazy"
      />
    </div>

    <div class="glass rounded-2xl p-8">
      {
        sent && (
          <div class="mb-6 rounded-xl border border-emerald-400/40 bg-emerald-500/10 p-4 text-sm text-emerald-200">
            Message sent. I have stored it in the database.
          </div>
        )
      }
      <form method="post" action="/api/contact" class="space-y-5">
        <input type="hidden" name="source" value="landing" />
        <div>
          <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Name</label>
          <input
            name="name"
            type="text"
            required
            value={user?.name ?? ''}
            class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
            placeholder="John Doe"
          />
        </div>
        <div>
          <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Email</label>
          <input
            name="email"
            type="email"
            required
            value={user?.email ?? ''}
            class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
            placeholder="john@example.com"
          />
        </div>
        <div>
          <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Message</label>
          <textarea
            name="message"
            rows="5"
            required
            class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
            placeholder="Tell me about your project goals..."
          ></textarea>
        </div>
        <button type="submit" class="w-full rounded-xl bg-brand px-4 py-3 font-headline font-bold text-white transition hover:brightness-110">
          Send Message
        </button>
      </form>
    </div>
  </section>

  <footer class="border-t border-line/70 bg-ink/80 py-10">
    <div class="section-shell flex flex-col items-center justify-between gap-4 px-6 md:flex-row md:px-8">
      <p class="font-label text-xs uppercase tracking-[0.3em] text-mist">© 2026 Editorial Engineering</p>
      <div class="flex gap-6 text-xs uppercase tracking-[0.25em] text-mist">
        <a href="#">Twitter</a>
        <a href="#">LinkedIn</a>
        <a href="#">GitHub</a>
      </div>
    </div>
  </footer>
</SiteLayout>
