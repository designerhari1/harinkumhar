---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCta from '../components/SiteCta.astro';
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>H | Webflow &amp; Frontend Developer</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Manrope:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        font-family: 'Manrope', sans-serif;
        background-color: #f9f9f9;
        color: #2d3435;
      }

      .serif-italic {
        font-family: 'Newsreader', serif;
        font-style: italic;
      }

      .headline-lg {
        font-size: clamp(2.5rem, 8vw, 4rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
      }

      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
      }

      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>
  <body class="bg-background text-on-surface selection:bg-primary-container selection:text-on-primary-container">
    <SiteHeader />

    <main class="pb-28 pt-32 md:pb-0" id="home">
      <section class="mx-auto flex min-h-[819px] max-w-[1440px] flex-col justify-center px-8">
        <div class="mb-8 flex items-center gap-4">
          <span class="relative inline-flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/50"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-500 ring-2 ring-emerald-100"></span>
          </span>
          <span class="font-label text-[11px] uppercase tracking-[0.2em] text-secondary">Available for new projects</span>
        </div>
        <div class="max-w-5xl">
          <h1 class="headline-lg mb-12 font-headline">
            I build <span class="serif-italic">high-impact</span> digital experiences for modern brands.
          </h1>
          <div class="flex flex-col gap-6 sm:flex-row">
            <a
              class="flex items-center justify-center gap-2 rounded-full bg-primary px-10 py-5 font-label text-sm uppercase tracking-widest text-on-primary transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-dim"
              href="#contact"
            >
              Start a Project
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
            <a
              class="flex items-center justify-center rounded-full border border-outline-variant/20 px-10 py-5 font-label text-sm uppercase tracking-widest transition-all duration-300 hover:bg-surface-container-low"
              href="#work"
            >
              View Work
            </a>
          </div>
        </div>
        <div class="mt-24 grid grid-cols-1 gap-12 border-t border-outline-variant/10 pt-12 md:grid-cols-3">
          <div>
            <p class="mb-4 font-label text-[10px] uppercase tracking-widest text-outline">Focused On</p>
            <p class="font-body text-on-surface">Digital products that balance aesthetics with conversion-focused strategy.</p>
          </div>
          <div>
            <p class="mb-4 font-label text-[10px] uppercase tracking-widest text-outline">Core Stack</p>
            <p class="font-body text-on-surface">React, Next.js, Webflow, Tailwind CSS, Framer Motion.</p>
          </div>
          <div>
            <p class="mb-4 font-label text-[10px] uppercase tracking-widest text-outline">Based In</p>
            <p class="font-body text-on-surface">Remote, globally. Available for synchronized collaboration.</p>
          </div>
        </div>
      </section>

      <section class="bg-surface-container-low py-32" id="work">
        <div class="mx-auto max-w-[1440px] px-8">
          <div class="mb-20 flex items-end justify-between">
            <div class="max-w-xl">
              <p class="mb-4 font-label text-[11px] uppercase tracking-[0.2em] text-primary">Selected Works</p>
              <h2 class="font-headline text-4xl sm:text-5xl">Curation of <span class="serif-italic">Digital Experiences</span></h2>
            </div>
            <a class="hidden border-b border-primary/20 pb-1 font-label text-xs uppercase tracking-widest transition-all hover:border-primary md:block" href="#">Explore Portfolio</a>
          </div>

          <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-20">
            <a class="group block cursor-pointer lg:col-span-7" href="https://boltic.io/" rel="noreferrer" target="_blank">
              <div class="relative aspect-[16/10] overflow-hidden rounded-xl bg-surface-container-highest">
                <img
                  class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                  alt="Fynd Boltic AI workflow automation landing page preview with product headline and CTA"
                  src="/projects/boltic.jpg"
                  loading="lazy"
                />
              </div>
              <div class="mt-8 flex items-start justify-between">
                <div>
                  <h3 class="mb-2 font-headline text-2xl">Fynd Boltic</h3>
                  <div class="flex gap-2">
                    <span class="tag">Workflow Automation</span>
                    <span class="tag">AI Product</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-outline-variant transition-colors group-hover:text-primary">north_east</span>
              </div>
            </a>

            <a class="group block cursor-pointer lg:col-span-5" href="https://www.kaily.ai/" rel="noreferrer" target="_blank">
              <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-surface-container-highest">
                <img
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  alt="Kaily AI website preview showcasing conversational AI workflow interfaces"
                  src="/projects/kaily-mobile-clean.png"
                  loading="lazy"
                />
              </div>
              <div class="mt-8">
                <h3 class="mb-2 font-headline text-2xl">Fynd Kaily</h3>
                <div class="flex gap-2">
                  <span class="tag">Conversational AI</span>
                  <span class="tag">Automation</span>
                </div>
              </div>
            </a>

            <a class="group block cursor-pointer lg:col-span-5" href="https://www.pixelbin.io/" rel="noreferrer" target="_blank">
              <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-surface-container-highest">
                <img
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  alt="Pixelbin media optimization dashboard preview with image transformation tooling"
                  src="/projects/pixelbin-mobile.png"
                  loading="lazy"
                />
              </div>
              <div class="mt-8">
                <h3 class="mb-2 font-headline text-2xl">Fynd Pixelbin</h3>
                <div class="flex gap-2">
                  <span class="tag">Media API</span>
                  <span class="tag">Developer Tools</span>
                </div>
              </div>
            </a>

            <a class="group block cursor-pointer lg:col-span-7" href="https://jiocommerce.io/" rel="noreferrer" target="_blank">
              <div class="relative aspect-[16/10] overflow-hidden rounded-xl bg-surface-container-highest">
                <img
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  alt="JioCommerce platform interface preview for digital commerce operations"
                  src="/projects/jiocommerce.jpg"
                  loading="lazy"
                />
              </div>
              <div class="mt-8 flex items-start justify-between">
                <div>
                  <h3 class="mb-2 font-headline text-2xl">Jio Commerce</h3>
                  <div class="flex gap-2">
                    <span class="tag">Commerce Platform</span>
                    <span class="tag">Enterprise</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-outline-variant transition-colors group-hover:text-primary">north_east</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-[1440px] px-8 py-40" id="services">
        <div>
          <div class="mb-20 max-w-5xl">
            <p class="mb-6 font-label text-[11px] uppercase tracking-[0.2em] text-primary">Expertise</p>
            <h2 class="mb-12 font-headline text-5xl">I specialize in bridging the gap between <span class="serif-italic">design and code</span>.</h2>
            <p class="leading-relaxed text-on-surface-variant">
              With over 5 years of experience, I help startups and established brands transform their vision into
              high-performing digital realities. Every pixel is intentional, every line of code is optimized.
            </p>
          </div>
          <div class="space-y-20">
            <div class="group border-b border-outline-variant/10 pb-12 transition-colors duration-500 hover:border-primary">
              <span class="mb-2 block font-label text-xs text-outline">01</span>
              <h4 class="mb-4 font-headline text-2xl">Webflow Development</h4>
              <p class="text-sm text-on-surface-variant">
                Custom, scalable, and fully responsive Webflow builds with clean structure and high-end interactions.
              </p>
            </div>
            <div class="group border-b border-outline-variant/10 pb-12 transition-colors duration-500 hover:border-primary">
              <span class="mb-2 block font-label text-xs text-outline">02</span>
              <h4 class="mb-4 font-headline text-2xl">React &amp; Next.js Apps</h4>
              <p class="text-sm text-on-surface-variant">
                Building dynamic, fast-loading web applications focused on user experience and seamless performance.
              </p>
            </div>
            <div class="group border-b border-outline-variant/10 pb-12 transition-colors duration-500 hover:border-primary">
              <span class="mb-2 block font-label text-xs text-outline">03</span>
              <h4 class="mb-4 font-headline text-2xl">Design Systems</h4>
              <p class="text-sm text-on-surface-variant">
                Creating cohesive visual languages that ensure brand consistency across all digital touchpoints.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white py-32" id="about">
        <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-12 px-8 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="mb-6 font-label text-[11px] uppercase tracking-[0.2em] text-primary">About H</p>
          </div>
          <div class="lg:col-span-8">
            <h3 class="mb-8 font-headline text-3xl leading-tight sm:text-4xl">
              I believe that great software is like fine architecture-it should be <span class="serif-italic">stable, useful, and beautiful</span>.
            </h3>
            <div class="mt-16 grid grid-cols-1 gap-12 font-body leading-relaxed text-on-surface-variant md:grid-cols-2">
              <p>
                My journey started with a fascination for how design influences human behavior. Today, I use that curiosity
                to build digital interfaces that don&apos;t just look pretty, but solve real business challenges.
              </p>
              <p>
                When I&apos;m not coding, I&apos;m likely exploring minimal architecture, studying typography, or helping fellow
                developers bridge the gap between Figma and the browser.
              </p>
            </div>
          </div>
        </div>
      </section>

      <SiteCta id="contact" />
    </main>

    <SiteFooter />
  </body>
</html>
