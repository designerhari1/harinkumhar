---
export const prerender = false;
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCta from '../components/SiteCta.astro';
---

<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>H | Work</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Manrope:wght@200..800&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        font-family: 'Manrope', sans-serif;
        background-color: #f9f9f9;
        color: #2d3435;
      }

      .font-serif {
        font-family: 'Newsreader', serif;
      }

      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
      }

      .glass-nav {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .project-card:hover .project-image {
        transform: scale(1.02);
      }
    </style>
  </head>
  <body class="bg-background text-on-surface selection:bg-primary-container selection:text-on-primary-container">
    <SiteHeader active="work" />

    <main class="mx-auto max-w-[1440px] px-8 pb-20 pt-32">
      <header class="mb-24">
        <span class="mb-4 block font-body text-[10px] uppercase tracking-[0.2em] text-primary">Selected Works</span>
        <h1 class="font-serif max-w-3xl text-5xl leading-[1.1] -tracking-[0.02em] text-on-surface md:text-7xl">
          Crafting digital experiences through <span class="italic">intentional</span> design.
        </h1>
      </header>

      <div class="mb-16 flex flex-wrap gap-4 border-b border-outline-variant/10 pb-8">
        <button class="rounded-full bg-on-surface px-5 py-2 text-xs font-semibold uppercase tracking-wide text-surface transition-all duration-300">All Projects</button>
        <button class="rounded-full border border-outline-variant/20 px-5 py-2 text-xs font-medium uppercase tracking-wide text-on-surface-variant transition-all duration-300 hover:border-primary">Webflow</button>
        <button class="rounded-full border border-outline-variant/20 px-5 py-2 text-xs font-medium uppercase tracking-wide text-on-surface-variant transition-all duration-300 hover:border-primary">React</button>
        <button class="rounded-full border border-outline-variant/20 px-5 py-2 text-xs font-medium uppercase tracking-wide text-on-surface-variant transition-all duration-300 hover:border-primary">Next.js</button>
      </div>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="project-card group md:col-span-8">
          <div class="mb-6 aspect-[16/9] overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Clean minimalist website interface design on a laptop screen with neutral tones and elegant typography in a bright studio"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBioZ_iPOGhHE973hkxvolCblT8JSQi4Or_dzqlifC-FaE6VcNQpblc61o9ojFL5PIhT_OgwOO8VpNs9EIEGKvLV9oOvPGZY0HUoSKvc6CNnrtK4uq3cqjo5U2I1vyU4AIXYl1uaZYgEGrEwe8_gPcggk69b6viEpn8v-Fp5SAoDEWsXPojp-8UDkVeGN1vY39GRqQTQ8z4QeA4GKzfHiAEwocOpEwwW4Kg2vmCXh2ixiKtsHD0EWF4kBbg4EuIm01vu1j93tBJ1g"
              loading="lazy"
            />
          </div>
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-3">
              <div class="flex gap-2">
                <span class="tag">Next.js</span>
                <span class="tag tag-muted">E-Commerce</span>
              </div>
              <h3 class="font-serif text-3xl text-on-surface">The Alchemist Atelier</h3>
              <p class="max-w-md font-body text-sm leading-relaxed text-on-surface-variant">
                A bespoke digital storefront for a premium fragrance house, focusing on immersive storytelling and seamless
                browsing flows.
              </p>
            </div>
            <a class="group/btn flex items-center gap-2 font-body text-xs font-bold uppercase tracking-widest text-primary transition-colors hover:text-on-surface" href="#">
              View Case Study
              <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
            </a>
          </div>
        </div>

        <div class="project-card group md:col-span-4">
          <div class="mb-6 aspect-[4/5] overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Abstract digital art with soft flowing 3d shapes in muted grey and indigo tones with grainy texture"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAuso-kT2B5IG8iB7hkjSflIomJTzkBD5eYPK5r5KLzG6HxIL6EbFnLbzPSflWLeMgfrqWk6h_-cz40WMAZfe2uh-D8RuXWkKXYLE32H7_kY6xqJqtIGKenRJtADImyUkGGFpcq3k0JlatrhLu73W1gV92loAZW9DVuj1k4ExzH0ado1nkUpsJNHkM6LXO-PIqOPLnoHdfjL_1ITdwT4K8BWaAskTU5Glsew9XDnXBFw0J49aZwp5vI61_PojRZS4SvliMZZSHzDw"
              loading="lazy"
            />
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <span class="tag">React</span>
            </div>
            <h3 class="font-serif text-2xl text-on-surface">Nova Analytics</h3>
            <p class="font-body text-sm leading-relaxed text-on-surface-variant">
              Complex data visualization platform for series-A fintech startups.
            </p>
            <a class="inline-flex items-center gap-2 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-primary" href="#">
              Case Study <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
          </div>
        </div>

        <div class="project-card group md:col-span-5">
          <div class="mb-6 aspect-square overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Minimalist architectural photography of a modern concrete building with sharp shadows and clear blue sky"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmJedbuihJKhclERT3wWImNUiB6-2H83reXBo7Rzb0CUcQVAk7jnPKtVS1wpBbf5s6vEgNyVWnMkwe89_CvEMtf_OGOTLq1oGjha2iKiNfoHP7W0D0oT0ZxfDK_OH9aF_gd00hS6s0MLx7kSUR9gjybN9pm53hUPZ5vUw61iGRHO_CDjpobD_IxrVMuT_rOTTobucHp9o98tjsnt1qvV_kYmH0YZy4raPmnZvPAnqtHnSH8XNglnYL6Xq_CxSELTBxtqRyas6bAQ"
              loading="lazy"
            />
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <span class="tag">Webflow</span>
            </div>
            <h3 class="font-serif text-2xl text-on-surface">Komorebi Interiors</h3>
            <p class="font-body text-sm leading-relaxed text-on-surface-variant">
              Portfolio site for a minimalist interior design studio in Tokyo.
            </p>
            <a class="inline-flex items-center gap-2 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-primary" href="#">
              Case Study <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
          </div>
        </div>

        <div class="project-card group md:col-span-7">
          <div class="mb-6 aspect-[16/10] overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Team of designers collaborating in a modern bright office space with large windows and wooden tables"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBQWO428ungjh1Q1XHU7NF4WmlVf4G-opI6oTzTKbVzGXFSbEibZvGKvrWsiAIaJdHxRGyUgWpoLoNrKTlSzDIPVXInqYLyfw_fZMlgO77a3443lAau71E025Lk-Lxb-oJKbO63LQyXAL8BFBcbBTN_M4-K5tooBQFNpypVSpv2BzAjM0tJ4AsiF2DWrqo9Hhu40lb217-KFISrmRVTbmSZZeJ2zmmyaDkDc9X45K-u64A4ONYXKdJs5sBzmKvI3h3qMLqsZjuiig"
              loading="lazy"
            />
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <span class="tag">Next.js</span>
              <span class="tag tag-muted">SaaS</span>
            </div>
            <h3 class="font-serif text-2xl text-on-surface">Flow State OS</h3>
            <p class="font-body text-sm leading-relaxed text-on-surface-variant">
              A productivity operating system designed to eliminate digital friction for remote teams.
            </p>
            <a class="inline-flex items-center gap-2 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-primary" href="#">
              Case Study <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
          </div>
        </div>
      </div>

      <SiteCta id="contact" />
    </main>

    <SiteFooter />
  </body>
</html>
