---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCta from '../components/SiteCta.astro';
---

<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>H | Work</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Manrope:wght@200..800&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        font-family: 'Manrope', sans-serif;
        background-color: #f9f9f9;
        color: #2d3435;
      }

      .font-serif {
        font-family: 'Newsreader', serif;
      }

      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
      }

      .glass-nav {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .project-card:hover .project-image {
        transform: scale(1.02);
      }
    </style>
  </head>
  <body class="bg-background text-on-surface selection:bg-primary-container selection:text-on-primary-container">
    <SiteHeader active="work" />

    <main class="mx-auto max-w-[1440px] px-8 pb-20 pt-32">
      <header class="mb-24">
        <span class="mb-4 block font-body text-[10px] uppercase tracking-[0.2em] text-primary">Selected Works</span>
        <h1 class="font-serif max-w-3xl text-5xl leading-[1.1] -tracking-[0.02em] text-on-surface md:text-7xl">
          Crafting digital experiences through <span class="italic">intentional</span> design.
        </h1>
      </header>

      <div class="mb-16 flex flex-wrap gap-4 border-b border-outline-variant/10 pb-8">
        <button class="rounded-full bg-on-surface px-5 py-2 text-xs font-semibold uppercase tracking-wide text-surface transition-all duration-300">All Projects</button>
        <button class="rounded-full border border-outline-variant/20 px-5 py-2 text-xs font-medium uppercase tracking-wide text-on-surface-variant transition-all duration-300 hover:border-primary">Webflow</button>
        <button class="rounded-full border border-outline-variant/20 px-5 py-2 text-xs font-medium uppercase tracking-wide text-on-surface-variant transition-all duration-300 hover:border-primary">React</button>
        <button class="rounded-full border border-outline-variant/20 px-5 py-2 text-xs font-medium uppercase tracking-wide text-on-surface-variant transition-all duration-300 hover:border-primary">Next.js</button>
      </div>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="project-card group md:col-span-8">
          <div class="mb-6 aspect-[16/9] overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Fynd Boltic AI workflow automation landing page preview with product headline and CTA"
              src="https://s.wordpress.com/mshots/v1/https%3A%2F%2Fwww.boltic.io%2F?w=1600"
              loading="lazy"
            />
          </div>
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-3">
              <div class="flex gap-2">
                <span class="tag">Workflow Automation</span>
                <span class="tag tag-muted">AI Product</span>
              </div>
              <h3 class="font-serif text-3xl text-on-surface">Fynd Boltic</h3>
              <p class="max-w-md font-body text-sm leading-relaxed text-on-surface-variant">
                AI workflow automation experience designed to streamline support processes and reduce operational costs for
                product teams.
              </p>
            </div>
            <a
              class="group/btn flex items-center gap-2 font-body text-xs font-bold uppercase tracking-widest text-primary transition-colors hover:text-on-surface"
              href="https://www.fynd.com/"
              rel="noreferrer"
              target="_blank"
            >
              View Case Study
              <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
            </a>
          </div>
        </div>

        <div class="project-card group md:col-span-4">
          <div class="mb-6 aspect-[4/5] overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Kaily AI product preview showcasing conversational automation and assistant workflows"
              src="/projects/kaily-ai.svg"
              loading="lazy"
            />
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <span class="tag">Conversational AI</span>
            </div>
            <h3 class="font-serif text-2xl text-on-surface">Kaily.ai</h3>
            <p class="font-body text-sm leading-relaxed text-on-surface-variant">
              AI-first assistant workflows designed to automate support interactions and improve response quality.
            </p>
            <a
              class="inline-flex items-center gap-2 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-primary"
              href="https://kaily.ai/"
              rel="noreferrer"
              target="_blank"
            >
              Case Study <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
          </div>
        </div>

        <div class="project-card group md:col-span-5">
          <div class="mb-6 aspect-square overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="Pixelbin interface preview highlighting media optimization and image transformation capabilities"
              src="/projects/pixelbin.svg"
              loading="lazy"
            />
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <span class="tag">Media API</span>
            </div>
            <h3 class="font-serif text-2xl text-on-surface">Pixelbin.io</h3>
            <p class="font-body text-sm leading-relaxed text-on-surface-variant">
              Developer-focused media infrastructure for transforming, optimizing, and delivering assets at scale.
            </p>
            <a
              class="inline-flex items-center gap-2 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-primary"
              href="https://www.pixelbin.io/"
              rel="noreferrer"
              target="_blank"
            >
              Case Study <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
          </div>
        </div>

        <div class="project-card group md:col-span-7">
          <div class="mb-6 aspect-[16/10] overflow-hidden rounded-xl bg-surface-container-low">
            <img
              class="project-image h-full w-full object-cover transition-transform duration-700 ease-out"
              alt="JioCommerce platform preview for enterprise commerce operations and customer journeys"
              src="/projects/jiocommerce.svg"
              loading="lazy"
            />
          </div>
          <div class="space-y-3">
            <div class="flex gap-2">
              <span class="tag">Commerce Platform</span>
              <span class="tag tag-muted">Enterprise</span>
            </div>
            <h3 class="font-serif text-2xl text-on-surface">JioCommerce.io</h3>
            <p class="font-body text-sm leading-relaxed text-on-surface-variant">
              Scalable commerce experience built for high-volume retail operations and omnichannel growth.
            </p>
            <a
              class="inline-flex items-center gap-2 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-primary"
              href="https://www.jiocommerce.io/"
              rel="noreferrer"
              target="_blank"
            >
              Case Study <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
          </div>
        </div>
      </div>

      <SiteCta id="contact" />
    </main>

    <SiteFooter />
  </body>
</html>
