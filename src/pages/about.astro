---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCta from '../components/SiteCta.astro';
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>H | About</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Manrope:wght@200..800&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        font-family: 'Manrope', sans-serif;
      }

      h1,
      h2,
      h3 {
        font-family: 'Newsreader', serif;
      }

      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
    </style>
  </head>
  <body class="bg-background text-on-background selection:bg-primary-container selection:text-on-primary-container">
    <SiteHeader active="about" />

    <main class="pb-20 pt-32">
      <section class="mx-auto mb-32 max-w-[1440px] px-8">
        <div class="flex flex-col items-end gap-12 md:grid md:grid-cols-12">
          <div class="md:col-span-8">
            <span class="mb-6 block font-label text-xs uppercase tracking-[0.2em] text-secondary">The Digital Craftsman</span>
            <h1 class="font-headline text-6xl italic leading-[0.9] -tracking-tight text-on-surface md:text-8xl">
              Engineering experiences that <br />
              <span class="ml-12 md:ml-24">feel like second nature.</span>
            </h1>
          </div>
          <div class="pb-4 md:col-span-4">
            <p class="font-body text-lg leading-relaxed text-on-surface-variant">
              I bridge the gap between static design and dynamic performance. A specialized developer focused on Webflow,
              React, and Next.js.
            </p>
          </div>
        </div>
      </section>

      <section class="mx-auto mb-40 max-w-[1440px] px-8">
        <div class="aspect-[21/9] w-full overflow-hidden rounded-xl bg-surface-container">
          <img
            class="h-full w-full object-cover opacity-90 grayscale transition-all duration-700 hover:grayscale-0"
            alt="Overhead view of a minimalist wooden desk with a sleek laptop, a notebook, and a ceramic coffee mug in soft morning light"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuD8jXz8REBHQdc3lf8GetF8jqOLHeln_-m9FOOJ2kX5_Zb-LxHEkfMiNYP3QJJYyP5Kog5S51mYCwCksnFTDdJev1gW6SiPODRfggJiMLRM_fb8VsEm9cycdvMzvegVH4qfXO-YpHZB6SR80oNlR5B3G9UaBAG_I8UkHvRcO5CBCwHvbRjFfBJwTCYCbSzaiftxzf3DLH0y6KWh1J8NDGD-SoAv5efHQXm3XMXi2NjXZgm-FJkDcCThAlVPqm-dVwzJWRf1-V4jcg"
            loading="lazy"
          />
        </div>
      </section>

      <section class="mx-auto mb-40 max-w-[1440px] px-8">
        <div class="gap-8 md:grid md:grid-cols-12">
          <div class="md:col-span-4">
            <h2 class="sticky top-32 text-3xl font-headline italic">The Genesis</h2>
          </div>
          <div class="space-y-12 md:col-span-7 md:col-start-6">
            <p class="font-body text-2xl leading-snug text-on-surface">
              I believe that code is an invisible architecture. For the last 6 years, I&apos;ve been obsessed with how digital
              spaces interact with the human psyche. My background isn&apos;t just in syntax-it&apos;s in the rhythm of interactions.
            </p>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
              <div>
                <h3 class="mb-4 font-label text-[10px] uppercase tracking-widest text-secondary">Webflow Specialist</h3>
                <p class="font-body text-sm text-on-surface-variant">
                  Converting high-fidelity designs into pixel-perfect, SEO-optimized, and lightning-fast Webflow builds. No
                  bloated code, just pure performance.
                </p>
              </div>
              <div>
                <h3 class="mb-4 font-label text-[10px] uppercase tracking-widest text-secondary">React &amp; Next.js</h3>
                <p class="font-body text-sm text-on-surface-variant">
                  Building scalable, headless architectures for complex web applications. I focus on server-side rendering and
                  state management that scales.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mb-40 bg-surface-container-low py-32">
        <div class="mx-auto max-w-[1440px] px-8">
          <div class="mb-20">
            <span class="mb-4 block font-label text-[10px] uppercase tracking-[0.2em] text-secondary">Capabilities</span>
            <h2 class="text-5xl font-headline italic">Core Strengths</h2>
          </div>
          <div class="grid grid-cols-1 gap-px bg-outline-variant/20 md:grid-cols-3">
            <div class="bg-surface p-12 transition-colors duration-500 hover:bg-surface-container">
              <span class="material-symbols-outlined mb-8 text-4xl text-primary">architecture</span>
              <h4 class="mb-4 text-xl font-headline italic">Systemic Design</h4>
              <p class="font-body text-sm leading-relaxed text-on-surface-variant">
                I don&apos;t just build pages; I build design systems. Component-driven development ensures consistency across every
                touchpoint.
              </p>
            </div>
            <div class="bg-surface p-12 transition-colors duration-500 hover:bg-surface-container">
              <span class="material-symbols-outlined mb-8 text-4xl text-primary">speed</span>
              <h4 class="mb-4 text-xl font-headline italic">Performance First</h4>
              <p class="font-body text-sm leading-relaxed text-on-surface-variant">
                Speed is a feature. My builds prioritize Core Web Vitals, semantic HTML, and optimized asset delivery for a
                frictionless user journey.
              </p>
            </div>
            <div class="bg-surface p-12 transition-colors duration-500 hover:bg-surface-container">
              <span class="material-symbols-outlined mb-8 text-4xl text-primary">fluid</span>
              <h4 class="mb-4 text-xl font-headline italic">Fluid Animation</h4>
              <p class="font-body text-sm leading-relaxed text-on-surface-variant">
                Motion should guide, not distract. I use GSAP and Framer Motion to create intentional movements that enhance
                narrative flow.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto mb-40 max-w-[1440px] px-8">
        <div class="gap-8 md:grid md:grid-cols-12">
          <div class="md:col-span-4">
            <h2 class="mb-12 text-3xl font-headline italic">Timeline</h2>
          </div>
          <div class="space-y-24 border-l border-outline-variant/30 pl-8 md:col-span-8 md:pl-16">
            <div class="relative">
              <div class="absolute -left-[41px] top-2 h-4 w-4 rounded-full bg-primary ring-8 ring-background md:-left-[73px]"></div>
              <span class="font-label text-[10px] uppercase tracking-widest text-secondary">2021 - Present</span>
              <h3 class="mt-2 text-2xl font-headline italic">Senior Product Developer</h3>
              <p class="mt-4 max-w-xl font-body text-on-surface-variant">
                Leading frontend architecture for boutique creative agencies. Specialized in bridging the gap between Figma
                designs and production-ready React applications.
              </p>
            </div>

            <div class="relative">
              <div class="absolute -left-[41px] top-2 h-4 w-4 rounded-full bg-outline-variant ring-8 ring-background md:-left-[73px]"></div>
              <span class="font-label text-[10px] uppercase tracking-widest text-secondary">2019 - 2021</span>
              <h3 class="mt-2 text-2xl font-headline italic">Freelance Webflow Engineer</h3>
              <p class="mt-4 max-w-xl font-body text-on-surface-variant">
                Partnered with 20+ global startups to launch high-conversion marketing sites. Focused on custom code
                integrations and CMS-heavy infrastructures.
              </p>
            </div>

            <div class="relative">
              <div class="absolute -left-[41px] top-2 h-4 w-4 rounded-full bg-outline-variant ring-8 ring-background md:-left-[73px]"></div>
              <span class="font-label text-[10px] uppercase tracking-widest text-secondary">2017 - 2019</span>
              <h3 class="mt-2 text-2xl font-headline italic">Junior Frontend Developer</h3>
              <p class="mt-4 max-w-xl font-body text-on-surface-variant">
                Mastered the fundamentals of the modern web stack. Built responsive interfaces and learned the art of semantic,
                accessible HTML.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto mb-40 max-w-[1440px] px-8">
        <div class="rounded-xl bg-surface-container-lowest p-12 shadow-[0_20px_40px_rgba(45,52,53,0.04)] md:p-20">
          <div class="items-center gap-20 md:grid md:grid-cols-2">
            <div>
              <h2 class="mb-8 text-4xl font-headline italic">The Workflow</h2>
              <p class="mb-8 font-body leading-relaxed text-on-surface-variant">
                My process is linear and transparent. I start with a deep dive into the &apos;why&apos;, followed by technical mapping and
                rapid prototyping. I prefer tight feedback loops and async communication.
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="tag">NEXT.JS</span>
                <span class="tag">WEBFLOW</span>
                <span class="tag">TAILWIND CSS</span>
                <span class="tag">TYPESCRIPT</span>
                <span class="tag">GSAP</span>
                <span class="tag">FIGMA</span>
              </div>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-4 md:mt-0">
              <div class="aspect-square overflow-hidden rounded-lg bg-surface-container">
                <img
                  class="h-full w-full object-cover"
                  alt="Close up of colorful code on a dark computer screen in a dimly lit room with blue and purple highlights"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDayCYa3QbiIyBfiZHjW4Yl1LMdH_1cvHojqFZcIoBKigcL0Q1eWg8dBrkHedNVU-N6m13-ZlBfh6SghdKwdKk148UURtZkHTgpVBmiUYCO2guKOkAiTSnx0aiKbnvqXHPVZWQo7rfGxDe6mGfLelCtvD7iQ_0Drwni81D71aINPSe2HW0gHJl8azDlxUXorwQMyaWp9658zuuToDogX9E-lNj_YMOc69vw7fLbOBgMXeFlwry_0BDQpJefktOyfsgmEMBjvL8Vcw"
                  loading="lazy"
                />
              </div>
              <div class="aspect-square translate-y-8 overflow-hidden rounded-lg bg-surface-container">
                <img
                  class="h-full w-full object-cover"
                  alt="Minimalist figma interface design visible on a monitor with clean workspace surroundings"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDEbx0IPdUojWYl1igdF11RWOI0Uaw-jv61yGLcAsp2BguANt3W-uC3i4JsgzIHWMevc3ML1Td2WLChWHaH60gnZqM10UqtKOxo2-4P3iNCJngRlTHxpzFcyzXoiupBt9s0M-PKU2OgaGbVfllAkA227oOAbA5W6vHAOVBLcAcwZrK2WgE1fWVzNSc20iPpW3KtgKnbEoJfkucZbfvESVqlpNio-xtESgyPW4sAKss8nnSb8LPj0-myg8-lQK2L_ddhv_cz8esAMQ"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <SiteCta id="contact" />
    </main>

    <SiteFooter />
  </body>
</html>
