---
import SiteLayout from '../layouts/SiteLayout.astro';
import { listLeadsForUser } from '../lib/db';

export const prerender = false;

const user = Astro.locals.user;
const leads = user ? await listLeadsForUser(user.id) : [];
const saved = Astro.url.searchParams.get('saved') === '1';
---

<SiteLayout title="Dashboard | EC App">
  <section class="section-shell px-6 py-14 md:px-8">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="font-label text-xs uppercase tracking-[0.24em] text-brandSoft">Client dashboard</p>
        <h1 class="mt-3 font-headline text-4xl font-bold tracking-tight md:text-5xl">Hi {user?.name}, your project space.</h1>
      </div>
      <div class="glass rounded-2xl px-5 py-4 text-right">
        <p class="text-xs uppercase tracking-[0.2em] text-mist">Saved requests</p>
        <p class="mt-2 font-headline text-3xl font-bold">{leads.length}</p>
      </div>
    </div>

    {
      saved && (
        <div class="mt-8 rounded-xl border border-emerald-400/40 bg-emerald-500/10 p-4 text-sm text-emerald-200">
          Message saved to database and linked to your account.
        </div>
      )
    }

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12">
      <div class="glass rounded-3xl p-8 lg:col-span-5">
        <h2 class="font-headline text-2xl font-bold">Send a new request</h2>
        <p class="mt-2 text-sm text-mist">This stores directly to your account records.</p>

        <form method="post" action="/api/contact" class="mt-6 space-y-4">
          <input type="hidden" name="source" value="dashboard" />
          <input type="hidden" name="name" value={user?.name ?? ''} />
          <input type="hidden" name="email" value={user?.email ?? ''} />

          <div>
            <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Project details</label>
            <textarea
              name="message"
              rows="6"
              required
              class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
              placeholder="Example: Need a redesign of our SaaS marketing site with CMS + blog migration."
            ></textarea>
          </div>
          <button type="submit" class="w-full rounded-xl bg-brand px-4 py-3 font-headline font-bold text-white transition hover:brightness-110">
            Save Request
          </button>
        </form>
      </div>

      <div class="lg:col-span-7">
        <h2 class="font-headline text-2xl font-bold">Your activity</h2>
        <p class="mt-2 text-sm text-mist">Most recent requests are shown first.</p>

        <div class="mt-6 space-y-4">
          {
            leads.length === 0 ? (
              <div class="glass rounded-2xl p-6 text-sm text-mist">No requests yet. Use the form to create your first one.</div>
            ) : (
              leads.map((lead) => (
                <article class="glass rounded-2xl p-6">
                  <p class="text-sm leading-relaxed text-white">{lead.message}</p>
                  <div class="mt-4 border-t border-line/70 pt-3 text-xs uppercase tracking-[0.2em] text-mist">
                    {new Date(lead.createdAt).toLocaleString()}
                  </div>
                </article>
              ))
            )
          }
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
