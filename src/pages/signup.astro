---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
---

<SiteLayout title="Sign Up | EC App">
  <section class="section-shell flex min-h-[86vh] items-center justify-center px-6 py-16 md:px-8">
    <div class="glass w-full max-w-lg rounded-3xl p-8 md:p-10">
      <p class="font-label text-xs uppercase tracking-[0.24em] text-brandSoft">Create account</p>
      <h1 class="mt-4 font-headline text-4xl font-bold tracking-tight">Start your project workspace</h1>
      <p class="mt-4 text-sm text-mist">Sign up to unlock dashboard tracking and saved requests.</p>

      {
        error && (
          <div class="mt-6 rounded-xl border border-rose-400/40 bg-rose-500/10 p-3 text-sm text-rose-200">
            {error}
          </div>
        )
      }

      <form method="post" action="/api/signup" class="mt-8 space-y-5">
        <div>
          <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Name</label>
          <input
            name="name"
            type="text"
            required
            minlength="2"
            class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
            placeholder="Alex Carter"
          />
        </div>
        <div>
          <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Email</label>
          <input
            name="email"
            type="email"
            required
            class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
            placeholder="you@company.com"
          />
        </div>
        <div>
          <label class="mb-2 block font-label text-xs uppercase tracking-[0.2em] text-mist">Password</label>
          <input
            name="password"
            type="password"
            required
            minlength="8"
            class="w-full rounded-xl border border-line bg-ink/80 px-4 py-3 text-white placeholder:text-mist/60 focus:border-brandSoft focus:ring-brandSoft"
            placeholder="At least 8 characters"
          />
        </div>

        <button type="submit" class="w-full rounded-xl bg-brand px-4 py-3 font-headline font-bold text-white transition hover:brightness-110">
          Create Account
        </button>
      </form>

      <p class="mt-6 text-sm text-mist">
        Already signed up?
        <a href="/login" class="font-bold text-brandSoft hover:text-white">Login</a>
      </p>
    </div>
  </section>
</SiteLayout>
