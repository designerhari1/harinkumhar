---
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Frontend and Webflow development app' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              ink: '#0f1115',
              coal: '#141922',
              mist: '#9ea5b5',
              line: '#242d3e',
              brand: '#4f46e5',
              brandSoft: '#a8b2ff',
              glow: '#67e8f9'
            },
            fontFamily: {
              headline: ['Newsreader', 'serif'],
              body: ['Manrope', 'sans-serif'],
              label: ['Manrope', 'sans-serif']
            },
            boxShadow: {
              halo: '0 25px 80px rgba(79,70,229,0.25)'
            }
          }
        }
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        background: radial-gradient(circle at top right, rgba(79, 70, 229, 0.22), transparent 45%),
          radial-gradient(circle at 10% 20%, rgba(103, 232, 249, 0.18), transparent 35%), #0f1115;
        color: #f4f7ff;
        min-height: 100vh;
      }

      .glass {
        background: rgba(20, 25, 34, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(158, 165, 181, 0.16);
      }

      .section-shell {
        max-width: 1200px;
        margin: 0 auto;
      }
    </style>
  </head>
  <body class="font-body">
    <SiteHeader />
    <main class="pt-28">
      <slot />
    </main>
  </body>
</html>
